ANTHROPIC_API_KEY=            # required
DATABASE_URL=postgres://postgres:dev@localhost:5432/agent
MODEL=claude-sonnet-4-5       # default model id; confirm the current id before use
MAX_STEPS=25                  # iteration cap
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=2
RUN_BUDGET_USD=1.00           # abort a run above this
ANTHROPIC_BASE_URL=           # optional; set to a llama.cpp endpoint for local runs
CACHE_PROMPT=false            # optional; enable Anthropic prompt caching on tool definitions
MAX_CONTEXT_TOKENS=150000     # compact the conversation above this estimated size
KEEP_RECENT_MESSAGES=8        # recent messages never truncated by compaction
OTEL_EXPORTER=none            # none | console | otlp — emit GenAI-convention spans
OTEL_ENDPOINT=                # OTLP collector URL when OTEL_EXPORTER=otlp
LOG_LEVEL=INFO                # structured JSON logs on stderr, correlated by run_id
LOG_JSON=true                 # false for human-readable lines during local dev
VOYAGE_API_KEY=               # optional; enables real semantic embeddings for search_docs
EMBEDDING_MODEL=voyage-3      # embedding model id (1024 dims, matches the schema)
DISTRIBUTED_GUARDRAILS=false  # true to share rate-limit/breaker state across workers via Postgres
RATE_LIMIT_PER_SECOND=2.0     # sustained LLM request rate
RATE_LIMIT_BURST=5.0          # bucket capacity
BREAKER_THRESHOLD=5           # consecutive failures before the circuit opens
BREAKER_RESET_SECONDS=30.0    # cooldown before a half-open probe
